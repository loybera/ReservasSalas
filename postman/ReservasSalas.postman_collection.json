              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const inicios = pm.response.json().map(r => new Date(r.inicio).toISOString());",
                  "pm.test(\"Las dos reservas activas, ordenadas\", () => pm.expect(inicios).to.eql([",
