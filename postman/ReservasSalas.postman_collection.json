{
  "info": {
    "_postman_id": "5400c11d-b640-441c-a504-52aa410452aa",
    "name": "Reservas de salas",
    "description": "Pruebas de la API de reservas (ejercicio 1).\n\nCorrer en orden con el Collection Runner: cada request guarda los ids que usan los siguientes. Cada corrida crea una sala nueva, así se puede repetir sin limpiar la base.\n\nCambiar `baseUrl` si la API no corre en http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fechas de prueba: un día 7 días en el futuro, en UTC. Se recalculan en cada request.",
          "const base = new Date();",
          "base.setUTCDate(base.getUTCDate() + 7);",
          "base.setUTCHours(0, 0, 0, 0);",
          "const a = (h, m = 0, dias = 0) => new Date(base.getTime() + ((dias * 24 + h) * 60 + m) * 60000).toISOString();",
          "const set = (k, v) => pm.collectionVariables.set(k, v);",
          "set('dia', base.toISOString().slice(0, 10));",
          "set('inicio0900', a(9)); set('inicio0930', a(9, 30)); set('fin1000', a(10)); set('fin1030', a(10, 30)); set('fin1100', a(11));",
          "set('inicio1400', a(14)); set('fin1410', a(14, 10)); set('fin1500', a(15));",
          "// 09:00 UTC = 06:00 en -03:00",
          "set('inicio0900Local', base.toISOString().slice(0, 10) + 'T06:00:00-03:00');",
          "set('fin1000Local', base.toISOString().slice(0, 10) + 'T07:00:00-03:00');",
          "const ayer = new Date(); ayer.setUTCDate(ayer.getUTCDate() - 1); ayer.setUTCHours(9, 0, 0, 0);",
          "set('ayer0900', ayer.toISOString()); set('ayer1000', new Date(ayer.getTime() + 3600000).toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "organizador",
      "value": "ana@empresa.com"
    },
    {
      "key": "salaId",
      "value": ""
    },
    {
      "key": "reservaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Salas",
      "item": [
        {
          "name": "Crear sala",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"nombreSala\", \"Sala Postman \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const sala = pm.response.json();",
                  "pm.collectionVariables.set(\"salaId\", sala.id);",
                  "pm.test(\"Devuelve id, nombre y capacidad\", () => {",
                  "    pm.expect(sala.id).to.be.a(\"string\");",
                  "    pm.expect(sala.nombre).to.eql(pm.collectionVariables.get(\"nombreSala\"));",
                  "    pm.expect(sala.capacidad).to.eql(6);",
                  "});",
                  "pm.test(\"Header Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/salas/\" + sala.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/salas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "salas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombreSala}}\",\n  \"capacidad\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
